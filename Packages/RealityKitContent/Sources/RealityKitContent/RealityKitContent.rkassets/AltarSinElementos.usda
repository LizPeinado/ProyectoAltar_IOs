#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def "Altar_vacio" (
        active = true
        customData = {
            float3 rotationEulerHint = (1.5707959, 3.1415927, 3.141593)
        }
        prepend references = @Altar_vacio.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 2.2476458e-8, -8.4293696e-8)
        float3 xformOp:scale = (0.1, 0.1, 0.1)
        float3 xformOp:translate = (0, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "florero" (
        active = true
        prepend references = @florero.usdz@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0.32600403, -0.57524943)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = [
                </Root/florero/OnNotification>,
                </Root/florero/OnTap>,
            ]
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def RealityKitComponent "Collider"
        {
            uint group = 1
            uniform token info:id = "RealityKit.Collider"
            uint mask = 4294967295
            token type = "Default"

            def RealityKitStruct "Shape"
            {
                float3 extent = (0.23872223, 0.23018865, 0.37225604)
                token shapeType = "Box"

                def RealityKitStruct "pose"
                {
                    float3 position = (0.0022426322, 0.008500837, 0.1861453)
                }
            }
        }

        def Preliminary_Behavior "OnNotification"
        {
            rel actions = </Root/florero/OnNotification/Action>
            uniform bool exclusive
            rel triggers = </Root/florero/OnNotification/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/florero>
                string identifier = "florero"
                token info:id = "Notification"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = None
                rel animationLibraryKeyOverrideKey = </Root/florero/OnNotification/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }

        def Preliminary_Behavior "OnTap"
        {
            rel actions = </Root/florero/OnTap/Action>
            uniform bool exclusive
            rel triggers = </Root/florero/OnTap/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/florero>
                token info:id = "TapGesture"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = None
                rel animationLibraryKeyOverrideKey = </Root/florero/OnTap/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }

        def RealityKitComponent "InputTarget"
        {
            uniform token info:id = "RealityKit.InputTarget"
        }
    }
}

