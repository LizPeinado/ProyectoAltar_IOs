#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    endTimeCode = 280
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "Root"
{
    float xformOp:rotateX = -90
    float3 xformOp:scale = (0.4776718, 0.4776718, 0.4776718)
    double3 xformOp:translate = (0.4934613273839876, 0.4887459392366337, -0.010757460069621826)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]

    def Xform "oliver_idle" (
        prepend references = @modelos/oliver/oliver_idle.usdz@
    )
    {
        def RealityKitComponent "AnimationLibrary"
        {
            token info:id = "RealityKit.AnimationLibrary"

            def RealityKitAnimationFile "idle"
            {
                uniform bool looping = 1
                uniform string name = "default subtree animation"
            }

            def RealityKitAnimationFile "oliver_baila"
            {
                uniform asset file = @Animations/oliver_baila.usdz@
                uniform bool looping = 1
                uniform string name = "oliver_baila"
            }
        }

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = [
                </Root/oliver_idle/OnAddedToScene>,
                </Root/oliver_idle/OnNotification_baila>,
                </Root/oliver_idle/OnNotification_idle>,
            ]
            token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnAddedToScene"
        {
            rel actions = </Root/oliver_idle/OnAddedToScene/Action>
            bool exclusive = 1
            rel triggers = </Root/oliver_idle/OnAddedToScene/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/oliver_idle>
                token info:id = "SceneTransition"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/idle>
                rel animationLibraryKeyOverrideKey = </Root/oliver_idle/OnAddedToScene/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }

        def Preliminary_Behavior "OnNotification_baila"
        {
            rel actions = </Root/oliver_idle/OnNotification_baila/Action>
            bool exclusive = 1
            rel triggers = </Root/oliver_idle/OnNotification_baila/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/oliver_idle>
                string identifier = "baila"
                token info:id = "Notification"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/baila>
                rel animationLibraryKeyOverrideKey = </Root/oliver_idle/OnNotification_baila/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }

        def Preliminary_Behavior "OnNotification_idle"
        {
            rel actions = </Root/oliver_idle/OnNotification_idle/Action>
            bool exclusive = 1
            rel triggers = </Root/oliver_idle/OnNotification_idle/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/oliver_idle>
                string identifier = "idle"
                token info:id = "Notification"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/idle>
                rel animationLibraryKeyOverrideKey = </Root/oliver_idle/OnNotification_idle/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }
    }

    def RealityKitTimeline "idle"
    {
        token info:id = "A901A571-B7BB-4C3F-A383-86F37C48BB73"

        def RealityKitTrack "Track"
        {
            uniform token info:id = "128A33D8-B3EC-450D-86DB-63B811C9C9B6"

            def RealityKitAction "Play_Animation"
            {
                string actionKind = "animation"
                string animation = "default subtree animation"
                double duration = 9.333333333333334
                token info:id = "3CC8D273-11CD-4608-B448-1C1C3663E650"
                double loopCount = 0
                bool separateAnimatedValue = 1
                double startTime = 0
                rel target = </Root/oliver_idle>

                def RealityKitStruct "handoffType"
                {
                }
            }
        }
    }

    def RealityKitTimeline "baila"
    {
        token info:id = "E35C7EC5-D3FA-44C8-9A79-32D4EB32B194"

        def RealityKitTrack "Track"
        {
            uniform token info:id = "845AF7B7-C68F-4831-BC52-BB0BF4EF2860"

            def RealityKitAction "Play_Animation"
            {
                string actionKind = "animation"
                string animation = "oliver_baila"
                int blendLayer = 500
                double duration = 212.793469
                token info:id = "3CDD19A5-B159-4A57-BD82-B1648E90144B"
                double loopCount = 0
                bool separateAnimatedValue = 1
                double startTime = 0
                rel target = </Root/oliver_idle>

                def RealityKitStruct "handoffType"
                {
                }
            }
        }
    }
}

