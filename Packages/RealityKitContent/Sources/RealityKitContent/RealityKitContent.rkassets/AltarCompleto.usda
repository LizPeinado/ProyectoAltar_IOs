#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    endTimeCode = 280
    framesPerSecond = 30
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "Root"
{
    float3 xformOp:translate = (0, 0, -1.3884802)
    uniform token[] xformOpOrder = []

    def "altar_completo" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707964, 0, 0)
        }
        references = @modelos/altar_completo.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1.0241176, 1.0241176, 1.0241176)
        float3 xformOp:translate = (0.055700116, 0.11061355, 0.16614051)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "vestido_catrina" (
        prepend references = @modelos/vestido_catrina.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (0.26525468, 0.26525468, 0.26525468)
        float3 xformOp:translate = (1.2742797, 0.1719769, -0.0043892986)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "OliverReposo"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (2.5, 2.5, 2.5)
        double3 xformOp:translate = (-1.600000023841858, -1.25, 0.10000000149011612)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "Visual" (
            prepend references = @oliver.usda@
        )
        {
            over "oliver_idle"
            {
                over "RCP_BehaviorsContainer"
                {
                    rel behaviors = None
                    uniform token info:id = "RCP.BehaviorsContainer"
                }
            }
        }

        def RealityKitComponent "HierarchicalFade"
        {
            uniform token info:id = "RealityKit.HierarchicalFade"
        }
    }
}

