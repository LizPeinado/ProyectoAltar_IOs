#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.60.2)"
    }
    defaultPrim = "Root"
    endTimeCode = 280
    framesPerSecond = 30
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "Root"
{
    double3 xformOp:translate = (0, 0, -2)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Xform "AltarSinElementos" (
        prepend references = @AltarSinElementos.usda@
    )
    {
        over "florero"
        {


        }
    }

    def Xform "AltarConFloreros" (
        prepend references = @AltarConFloreros.usda@
    )
    {
        over "pan_muerto"
        {


        }
    }

    def Xform "AltarConPanYFloreros" (
        prepend references = @AltarConPanYFloreros.usda@
    )
    {
        over "Skate"
        {


        }
    }

    def Xform "AltarCompleto" (
        prepend references = @AltarCompleto.usda@
    )
    {
        over "OliverReposo"
        {
            over "Visual"
            {
            }
        }

        over "vestido_catrina" (
            active = false
        )
        {
        }
    }

    def Xform "mp3" (
        prepend references = @modelos/mp3.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (0.11400619, 0.11400619, 0.11400619)
        float3 xformOp:translate = (0, 4.3996056e-9, 0.6947139)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "ZonaToque"
        {
            def RealityKitComponent "InputTarget"
            {
                uniform token info:id = "RealityKit.InputTarget"
            }

            def RealityKitComponent "Collider"
            {
                uint group = 1
                uniform token info:id = "RealityKit.Collider"
                uint mask = 4294967295
                token type = "Default"

                def RealityKitStruct "Shape"
                {
                    float3 extent = (2.631436, 0.67236024, 1.8429571)
                    token shapeType = "Box"

                    def RealityKitStruct "pose"
                    {
                        float3 position = (0, -0.046366867, 0.9214785)
                    }
                }
            }
        }

        def RealityKitComponent "AudioLibrary"
        {
            uniform token info:id = "RealityKit.AudioLibrary"

            def RealityKitDict "resources"
            {
                string[] keys = ["oliver_song.mp3"]
                rel values = </Root/oliver_song_mp3>
            }
        }






    }

    def Xform "OliverMusica"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (2.5, 2.5, 2.5)
        double3 xformOp:translate = (-1.600000023841858, -1.2499020099639893, 0.10000002384185791)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "Visual" (
            prepend references = @oliver.usda@
        )
        {
            over "oliver_idle"
            {
                over "RCP_BehaviorsContainer"
                {
                    rel behaviors = </Root/OliverMusica/Visual/oliver_idle/OnNotification_baila>
                    uniform token info:id = "RCP.BehaviorsContainer"
                }
            }
        }

        def RealityKitComponent "HierarchicalFade"
        {
            token info:id = "RealityKit.HierarchicalFade"
        }
    }







    def RealityKitAudioFile "oliver_song_mp3"
    {
        uniform asset file = @Audio/oliver_song.mp3@
        uniform bool shouldLoop = 0
    }

    def Xform "vestido_catrina" (
        prepend references = @modelos/vestido_catrina.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (0.26525468, 0.26525468, 0.26525468)
        float3 xformOp:translate = (1.2742797, 0.1719769, -0.0043892986)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "GuiasPasos"
    {
        def RealityKitComponent "HierarchicalFade"
        {
            token info:id = "RealityKit.HierarchicalFade"
        }

        def Xform "img_florero" (
            prepend references = @Guias.usda@</Root/img_florero>
        )
        {
        }

        def Xform "img_pan" (
            prepend references = @Guias.usda@</Root/img_pan>
        )
        {
        }

        def Xform "img_skate" (
            prepend references = @Guias.usda@</Root/img_skate>
        )
        {
        }

        def Xform "img_oliver" (
            prepend references = @Guias.usda@</Root/img_oliver>
        )
        {
        }
    }

    def Xform "GuiaOliverMusica" (
        prepend references = @Guias.usda@</Root/img_oliver>
    )
    {
        def RealityKitComponent "HierarchicalFade"
        {
            token info:id = "RealityKit.HierarchicalFade"
        }
    }
}

