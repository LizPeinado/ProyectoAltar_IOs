        references = @modelos/altar_floreros.usdz@
    )
    {
        reorder nameChildren = ["altar", "florero", "pan_muerto", "Plato_Ceramica_Pan_Individual_002", "_materials", "Cempasuchil_004", "Papel_Morado_Mariposa_001", "Cempasuchil_003", "Papel_Rosa_Corazon_002", "Cempasuchil_011", "Papel_Naranja_Calavera_002", "Cempasuchil_012", "Papel_Rosa_Corazon", "Papel_Morado_Mariposa", "Cempasuchil_010", "Papel_Naranja_Velas_001", "Papel_Morado_Catrina", "Cempasuchil_009", "Cempasuchil", "Papel_Naranja_Calavera", "Cempasuchil_001", "Mesh_001", "Cempasuchil_008", "Papel_Naranja_Calavera_003", "Papel_Naranja_Velas", "frame_mesh_001", "Cempasuchil_007", "Arco_Cempasuchil", "Papel_Rosa_Cempasuchiles_001", "Cube", "Cempasuchil_006", "Papel_Rosa_Corazon_001", "Cempasuchil_002", "Cempasuchil_005", "Papel_Naranja_Calavera_001", "env_light"]
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0.00001, 0, -1.56651)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "pan_muerto" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.5707964, 0, 0)
        }
        references = @modelos/pan_muerto.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
        float3 xformOp:scale = (1.5, 1.5, 1.5)
        float3 xformOp:translate = (0.008264661, -0.13411504, -0.23723796)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "Collider"
        {
            uint group = 1
            uniform token info:id = "RealityKit.Collider"
            uint mask = 4294967295
            token type = "Default"

            def RealityKitStruct "Shape"
            {
                float3 extent = (0.13975477, 0.1397548, 0.045820266)
                token shapeType = "Box"

                def RealityKitStruct "pose"
                {
                    float3 position = (-0.012640312, 0.14967555, 0.50836265)
                }
            }
        }

        def RealityKitComponent "InputTarget"
        {
            uniform token info:id = "RealityKit.InputTarget"
        }

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = </Root/pan_muerto/OnNotification>
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnNotification"
        {
            rel actions = </Root/pan_muerto/OnNotification/Action>
            uniform bool exclusive
            rel triggers = </Root/pan_muerto/OnNotification/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/pan_muerto>
                string identifier = "pan_muerto"
                token info:id = "Notification"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = None
                rel animationLibraryKeyOverrideKey = </Root/pan_muerto/OnNotification/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }
    }
}

